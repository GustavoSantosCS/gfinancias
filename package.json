{
    "name": "gfinancias",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "dev": "vp run -r dev",
        "build": "vp run -r build",
        "check-types": "vp run -r check-types",
        "check": "vp check apps/server apps/web/src packages/api/src packages/db/src packages/env/src packages/ui/src/components packages/ui/src/lib tests .github docs && vp run -r check-types",
        "lint": "vp lint",
        "format": "vp fmt",
        "staged": "vp staged",
        "hooks:setup": "vp hooks enable",
        "dev:web": "vp run --filter web dev",
        "dev:server": "vp run --filter server dev",
        "db:push": "vp run --filter @gfinancias/db db:push",
        "db:studio": "vp run --filter @gfinancias/db db:studio",
        "db:generate": "vp run --filter @gfinancias/db db:generate",
        "db:migrate": "vp run --filter @gfinancias/db db:migrate",
        "db:local": "vp run --filter @gfinancias/db db:local",
        "test": "vp test run",
        "prepare": "vp config --no-agent",
        "test:components": "vp test run --project react",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:install": "playwright install chromium",
        "test:coverage:backend": "vp test run --coverage apps/server/src/app.test.ts packages/db/src/index.test.ts --coverage.include=apps/server/src/app.ts --coverage.include=packages/api/src/routers/index.ts --coverage.include=packages/api/src/context.ts --coverage.include=packages/db/src/index.ts --coverage.thresholds.lines=60 --coverage.thresholds.statements=60 --coverage.thresholds.functions=60 --coverage.thresholds.branches=60",
        "test:coverage:frontend": "vp test run --project react --coverage tests/components/controls.test.tsx tests/components/stories.test.tsx --coverage.include=packages/ui/src/components/button.tsx --coverage.include=packages/ui/src/components/input.tsx --coverage.thresholds.lines=60 --coverage.thresholds.statements=60 --coverage.thresholds.functions=60 --coverage.thresholds.branches=60",
        "test:coverage": "npm run test:coverage:frontend && npm run test:coverage:backend",
        "test:ci": "npm run check && npm run test:coverage",
        "storybook": "storybook dev -p 6006 --no-open",
        "build-storybook": "storybook build",
        "lint:format:source": "node scripts/lint-format-source.mjs"
    },
    "dependencies": {
        "@gfinancias/env": "*",
        "dotenv": "^17.4.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@gfinancias/config": "*",
        "@playwright/test": "^1.63.0",
        "@storybook/addon-a11y": "10.3.0",
        "@storybook/addon-docs": "10.3.0",
        "@storybook/react": "10.3.0",
        "@storybook/react-vite": "10.3.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.2.0",
        "@vitest/coverage-v8": "4.1.11",
        "jsdom": "^29.1.1",
        "rolldown": "1.2.6",
        "storybook": "10.3.0",
        "typescript": "^6.0.3",
        "vite-plus": "0.3.0"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
    },
    "packageManager": "npm@11.19.1",
    "allowScripts": {
        "esbuild": true,
        "sharp": true,
        "@prisma/engines": true,
        "prisma": true
    }
}
